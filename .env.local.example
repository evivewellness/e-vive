# ─── Resend Email ────────────────────────────────────────────────────────────
# Required for email delivery. Get your key at https://resend.com/api-keys
# The sender domain (e-vive.co.ke) must be verified in your Resend account.
RESEND_API_KEY=re_your_api_key_here

# Optional: override the sender address (must match a verified Resend domain)
# EMAIL_FROM=E-Vive Kenya <hello@e-vive.co.ke>

# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
