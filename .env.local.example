# ─── Supabase ────────────────────────────────────────────────────────────────
# The URL is public. The service-role key is not: it bypasses Row Level
# Security entirely and must never carry a NEXT_PUBLIC_ prefix, or Next.js will
# inline it into the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Sessions ────────────────────────────────────────────────────────────────
# HMAC key for the signed session cookie. At least 32 characters. Generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# ─── Site ────────────────────────────────────────────────────────────────────
# Canonical origin. Used to build shared-report links, password reset links and
# the M-Pesa callback URL. Without it these fall back to the request's Host
# header, which an attacker can set.
NEXT_PUBLIC_SITE_URL=https://e-vive.vercel.app

# ─── Resend Email ────────────────────────────────────────────────────────────
# Required for email delivery. Get your key at https://resend.com/api-keys
# The sender domain (e-vive.co.ke) must be verified in your Resend account.
RESEND_API_KEY=re_your_api_key_here

# Optional: override the sender address (must match a verified Resend domain)
# EMAIL_FROM=E-Vive Kenya <hello@e-vive.co.ke>

# Signing secret for the Resend webhook (whsec_..., from the Resend dashboard).
# Without it, /api/webhooks/resend accepts events without verifying they came
# from Resend.
RESEND_WEBHOOK_SECRET=

# ─── M-Pesa (Daraja) ─────────────────────────────────────────────────────────
# Without these, /api/mpesa/stkpush returns 503 and payments are unavailable.
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=4165689
# 'sandbox' or 'production' — set explicitly before launch.
MPESA_ENV=sandbox
# Safaricom sends no credentials with its callback, so authorisation rides in
# the callback URL. Generate a long random value; it is only ever seen by
# Safaricom. Without it the callback endpoint is unauthenticated.
MPESA_CALLBACK_SECRET=

# ─── No longer used ──────────────────────────────────────────────────────────
# NEXT_PUBLIC_SUPABASE_ANON_KEY  — the browser no longer talks to Postgres.
# NEXT_PUBLIC_ADMIN_EMAIL/HASH   — admins are rows in admin_users.
